@model PdvViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Caixa / PDV";
    var catalogoJson = JsonSerializer.Serialize(
        Model.Catalogo.Select(p => new { id = p.IdProduto, nome = p.Nome, preco = p.Preco, estoque = p.Estoque }));
    var carrinhoJson = JsonSerializer.Serialize(
        Model.Itens.Select(i => new { id = i.IdProduto, qtd = i.Quantidade }));
    var formas = new[] { "Dinheiro", "Cartão de débito", "Cartão de crédito", "Pix" };
}

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="pdv-alert ok"><i class="bi bi-check-circle"></i> @sucesso</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="pdv-alert err">
        @foreach (var erro in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@erro.ErrorMessage</div>
        }
    </div>
}
<div id="aviso" class="pdv-alert err" hidden></div>

<form id="pdv-form" asp-action="Create" method="post" autocomplete="off"
      data-forma="@Model.FormaPagamento"
      data-desconto="@Model.DescontoCentavos"
      data-recebido="@Model.ValorRecebidoCentavos">
    <div class="pdv">

        <section class="pdv-main">
            <div class="card pdv-search">
                <div class="search-row">
                    <div class="search-box">
                        <i class="bi bi-upc-scan"></i>
                        <input id="busca" type="text" placeholder="Código ou nome do produto e Enter (F2)" />
                        <div id="sugestoes" class="sugestoes" hidden></div>
                    </div>
                    <input id="qtd" class="qtd-input" type="number" min="1" value="1" aria-label="Quantidade" />
                    <button type="button" id="btn-add" class="btn-primary"><i class="bi bi-plus-lg"></i> Adicionar</button>
                </div>
            </div>

            <div class="card pdv-cart" id="cart-box">
                <table class="grid" id="tabela" hidden>
                    <thead>
                        <tr><th>#</th><th>PRODUTO</th><th>QTD</th><th>UNITÁRIO</th><th>SUBTOTAL</th><th></th></tr>
                    </thead>
                    <tbody id="itens"></tbody>
                </table>
                <div id="vazio" class="pdv-empty">
                    <i class="bi bi-cart"></i>
                    <p>Nenhum item na venda.<br />Digite um código ou nome para começar.</p>
                </div>
            </div>
        </section>

        <aside class="card pdv-side">
            <h2>Resumo da venda</h2>

            <div class="sum-row"><span>Itens</span><strong id="sum-itens">0</strong></div>
            <div class="sum-row"><span>Subtotal</span><strong id="sum-subtotal">R$ 0,00</strong></div>

            <label class="sum-field">
                Desconto (R$)
                <input id="desconto" type="text" inputmode="decimal" value="0,00" />
            </label>

            <div class="sum-total"><span>TOTAL</span><strong id="sum-total">R$ 0,00</strong></div>

            <label class="sum-field">
                Forma de pagamento
                <select id="forma" name="FormaPagamento">
                    @foreach (var f in formas)
                    {
                        <option value="@f">@f</option>
                    }
                </select>
            </label>

            <div id="box-dinheiro">
                <label class="sum-field">
                    Valor recebido (R$)
                    <input id="recebido" type="text" inputmode="decimal" value="" placeholder="0,00" />
                </label>
                <div class="sum-row"><span>Troco</span><strong id="sum-troco" class="pos">R$ 0,00</strong></div>
            </div>

            <div id="hidden-fields"></div>

            <button type="submit" id="btn-finalizar" class="btn-finalizar"><i class="bi bi-check2-circle"></i> Finalizar venda (F9)</button>
            <button type="button" id="btn-cancelar" class="btn-cancelar"><i class="bi bi-x-circle"></i> Cancelar venda (F8)</button>

            <div class="sum-op">Operador: <strong>Admin</strong></div>
        </aside>
    </div>
</form>

<script id="catalogo-json" type="application/json">@Html.Raw(catalogoJson)</script>
<script id="carrinho-json" type="application/json">@Html.Raw(carrinhoJson)</script>
<script src="~/js/pdv.js" asp-append-version="true"></script>