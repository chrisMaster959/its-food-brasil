@model ProdutoListViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Estoque";
    var pt = new CultureInfo("pt-BR");
    string Money(decimal v) => v.ToString("C2", pt);

    bool filtrando = !string.IsNullOrWhiteSpace(Model.Busca) || Model.IdCategoria.HasValue || !string.IsNullOrEmpty(Model.Situacao);
}

<div class="stats stats-4">
    <div class="card stat">
        <div class="stat-top"><span class="stat-label">PRODUTOS ATIVOS</span><span class="stat-icon"><i class="bi bi-box-seam"></i></span></div>
        <strong>@Model.ProdutosAtivos</strong>
    </div>
    <div class="card stat">
        <div class="stat-top"><span class="stat-label">UNIDADES EM ESTOQUE</span><span class="stat-icon"><i class="bi bi-stack"></i></span></div>
        <strong>@Model.UnidadesEmEstoque.ToString("N0", pt)</strong>
    </div>
    <div class="card stat">
        <div class="stat-top"><span class="stat-label info">VALOR EM ESTOQUE</span><span class="stat-icon"><i class="bi bi-cash-coin"></i></span></div>
        <strong class="info">@Money(Model.ValorEmEstoque)</strong>
        <span class="stat-sub">A preço de venda</span>
    </div>
    <div class="card stat">
        <div class="stat-top"><span class="stat-label @(Model.ProdutosEmAlerta > 0 ? "neg" : "pos")">PRECISAM DE ATENÇÃO</span><span class="stat-icon"><i class="bi bi-exclamation-triangle"></i></span></div>
        <strong class="@(Model.ProdutosEmAlerta > 0 ? "neg" : "pos")">@Model.ProdutosEmAlerta</strong>
        <span class="stat-sub">Estoque baixo ou validade</span>
    </div>
</div>

<form method="get" class="card filters">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" name="busca" value="@Model.Busca" placeholder="Buscar por nome ou lote..." />
    </div>

    <select name="idCategoria" class="select">
        <option value="">Todas as categorias</option>
        @foreach (var c in Model.Categorias)
        {
            <option value="@c.IdCategoria" selected="@(Model.IdCategoria == c.IdCategoria)">@c.Nome</option>
        }
    </select>

    <select name="situacao" class="select">
        <option value="">Todas as situações</option>
        <option value="baixo" selected="@(Model.Situacao == "baixo")">Estoque baixo</option>
        <option value="sem" selected="@(Model.Situacao == "sem")">Sem estoque</option>
        <option value="proxima" selected="@(Model.Situacao == "proxima")">Validade próxima</option>
        <option value="vencido" selected="@(Model.Situacao == "vencido")">Vencidos</option>
        <option value="inativo" selected="@(Model.Situacao == "inativo")">Inativos</option>
    </select>

    <button type="submit" class="btn-primary"><i class="bi bi-funnel"></i> Filtrar</button>
    @if (filtrando)
    {
        <a class="btn-outline" asp-action="Index">Limpar</a>
    }
</form>

<section class="card table-card">
    <div class="table-head">
        <h2>Produtos</h2>
        <a class="btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Novo Produto</a>
    </div>

    <div class="table-scroll">
        <table class="grid">
            <thead>
                <tr>
                    <th>PRODUTO</th><th>CATEGORIA</th><th>PREÇO</th><th>ESTOQUE</th>
                    <th>LOTE</th><th>VALIDADE</th><th>STATUS</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Produtos)
            {
                <tr class="@(p.Ativo ? "" : "row-off")">
                    <td>
                        <strong>@p.Nome</strong>
                        <div class="muted">Cód. @p.IdProduto</div>
                    </td>
                    <td>@p.Categoria</td>
                    <td>@Money(p.Preco)</td>
                    <td>
                        @if (p.SemEstoque)
                        {
                            <span class="badge badge-err">Sem estoque</span>
                        }
                        else
                        {
                            <span class="@(p.EstoqueBaixo ? "neg strong" : "")">@p.Estoque</span>
                            @if (p.EstoqueBaixo)
                            {
                                <span class="badge badge-warn">Baixo</span>
                            }
                        }
                    </td>
                    <td>@(p.Lote ?? "-")</td>
                    <td>
                        @if (p.Validade.HasValue)
                        {
                            <span>@p.Validade.Value.ToString("dd/MM/yyyy")</span>
                            @if (p.Vencido)
                            {
                                <span class="badge badge-err">Vencido</span>
                            }
                            else if (p.ValidadeProxima)
                            {
                                <span class="badge badge-warn">Vence em @p.DiasParaVencer dia(s)</span>
                            }
                        }
                        else
                        {
                            <span class="muted">-</span>
                        }
                    </td>
                    <td>
                        @if (p.Ativo) { <span class="badge badge-ok">Ativo</span> }
                        else { <span class="badge badge-off">Inativo</span> }
                    </td>
                    <td class="actions">
                        <a class="icon-btn" asp-action="Details" asp-route-id="@p.IdProduto" title="Detalhes"><i class="bi bi-eye"></i></a>
                        <a class="icon-btn" asp-action="Edit" asp-route-id="@p.IdProduto" title="Editar"><i class="bi bi-pencil"></i></a>
                        <a class="icon-btn danger" asp-action="Delete" asp-route-id="@p.IdProduto" title="Excluir"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            @if (!Model.Produtos.Any())
            {
                <tr><td colspan="8" class="muted center">Nenhum produto encontrado.</td></tr>
            }
            </tbody>
        </table>
    </div>

    <div class="table-foot">
        <span class="muted">@Model.Produtos.Count produto(s) listado(s)</span>
        <span class="muted">Estoque baixo: menos de @ProdutoListViewModel.LimiteEstoqueBaixo un. · Validade próxima: até @ProdutoListViewModel.DiasValidadeProxima dias.</span>
    </div>
</section>