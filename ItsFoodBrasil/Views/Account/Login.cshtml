@model LoginViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Entrar";
}

<h1>Bem-vindo de volta</h1>
<p class="auth-sub">Entre com seu e-mail e senha para acessar o sistema.</p>

<form asp-action="Login" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-err"></div>

    <div class="field">
        <label asp-for="Email"></label>
        <div class="input">
            <i class="bi bi-envelope"></i>
            <input asp-for="Email" placeholder="voce@empresa.com" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="field-err"></span>
    </div>

    <div class="field">
        <label asp-for="Senha"></label>
        <div class="input">
            <i class="bi bi-lock"></i>
            <input asp-for="Senha" placeholder="Sua senha" autocomplete="current-password" />
            <button type="button" class="toggle" data-toggle-senha tabindex="-1" aria-label="Mostrar senha"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Senha" class="field-err"></span>
    </div>

    <label class="check">
        <input asp-for="Lembrar" type="checkbox" />
        <span>@Html.DisplayNameFor(m => m.Lembrar)</span>
    </label>

    <button type="submit" class="btn-submit">Entrar</button>
</form>