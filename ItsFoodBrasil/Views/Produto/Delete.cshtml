@model ItsFoodBrasil.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";

    var qtdVendas = (int)(ViewBag.QtdVendas ?? 0);
    bool podeExcluir = qtdVendas == 0;
}

<style>
    .del-card { padding:24px; max-width:640px; }
    .del-card dl { display:grid; grid-template-columns:150px 1fr; gap:10px 16px; margin:0 0 20px; }
    .del-card dt { color:#777; font-size:.75rem; font-weight:600; text-transform:uppercase; align-self:center; }
    .del-card dd { margin:0; }
    .del-aviso { background:#fff7e0; color:#8a6100; border-radius:8px; padding:12px 16px; margin-bottom:20px; }
    .del-aviso ul { margin:6px 0 0 18px; padding:0; }
    .del-acoes { display:flex; gap:10px; justify-content:flex-end; flex-wrap:wrap; }
    .btn-perigo { background:#b3261e !important; border-color:#b3261e !important; color:#fff !important; }
</style>

<div class="page-header">
    <div>
        <h2>Excluir Produto</h2>
        <p class="muted">Confirme antes de excluir. Essa ação não pode ser desfeita.</p>
    </div>

    <a asp-action="Index" class="btn-outline">
        <i class="bi bi-arrow-left"></i>
        Voltar
    </a>
</div>

<div class="card del-card">

    <dl>
        <dt>Produto</dt>
        <dd><strong>@Model.Nome</strong> <span class="muted">(Cód. @Model.IdProduto)</span></dd>

        <dt>Categoria</dt>
        <dd>@Model.Categoria?.Nome</dd>

        <dt>Preço</dt>
        <dd>@Model.Preco.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</dd>

        <dt>Em estoque</dt>
        <dd>@Model.QuantidadeEstoque un.</dd>

        <dt>Validade</dt>
        <dd>@(Model.Validade.HasValue ? Model.Validade.Value.ToString("dd/MM/yyyy") : "-")</dd>

        <dt>Status</dt>
        <dd>
            @if (Model.Ativo)
            {
                <span class="badge badge-ok">Ativo</span>
            }
            else
            {
                <span class="badge badge-off">Inativo</span>
            }
        </dd>

        <dt>Vendas com o produto</dt>
        <dd>@qtdVendas</dd>
    </dl>

    @if (!podeExcluir)
    {
        <div class="del-aviso">
            <strong>Este produto não pode ser excluído:</strong>
            <ul>
                <li>Aparece em @qtdVendas venda(s). Excluir apagaria o histórico. Desative o produto em vez de excluir.</li>
            </ul>
        </div>
    }
    else if (Model.QuantidadeEstoque > 0)
    {
        <div class="del-aviso">
            Atenção: ainda existem <strong>@Model.QuantidadeEstoque unidade(s)</strong> em estoque. Ao excluir, esse estoque deixa de ser contabilizado.
        </div>
    }

    <div class="del-acoes">
        <a asp-action="Index" class="btn-outline">Cancelar</a>

        @if (!podeExcluir && Model.Ativo)
        {
            <form asp-action="AlternarAtivo" asp-route-id="@Model.IdProduto" method="post">
                <button type="submit" class="btn-outline">
                    <i class="bi bi-eye-slash"></i> Desativar em vez de excluir
                </button>
            </form>
        }

        @if (podeExcluir)
        {
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.IdProduto" method="post">
                <button type="submit" class="btn-primary btn-perigo">
                    <i class="bi bi-trash"></i> Excluir definitivamente
                </button>
            </form>
        }
    </div>
</div>