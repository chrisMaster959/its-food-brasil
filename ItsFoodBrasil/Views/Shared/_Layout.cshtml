@using System.Linq

@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool On(string c, string? a = null) =>
        ctrl == c && (a == null || act == a);

    bool Grupo(params string[] cs) =>
        cs.Contains(ctrl);

    string Item(bool ativo) =>
        ativo ? "nav-item active" : "nav-item";

    string Sub(bool ativo) =>
        ativo ? "sub-item active" : "sub-item";

    string Group(bool aberto) =>
        aberto ? "nav-group open" : "nav-group";
}

<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Its Food Brasil</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>
<body>

<div class="app">

    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <aside class="sidebar">

        <!-- Logo / Empresa -->
        <div class="brand">

            <div class="brand-logo">
                <i class="bi bi-basket2-fill"></i>
            </div>

            <strong>Its Food Brasil</strong>

            <small>
                Distribuição de Embutidos
            </small>

        </div>


        <!-- =================================================
             MENU
             ================================================= -->

        <nav class="nav">

            <!-- Dashboard -->
            <a class="@Item(On("Home"))"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-house-door"></i>

                <span>Dashboard</span>

            </a>


            <!-- Caixa / PDV -->
            <a class="@Item(On("Venda"))"
               asp-controller="Venda"
               asp-action="Create">

                <i class="bi bi-cash-stack"></i>

                <span>Caixa / PDV</span>

            </a>


            <!-- =================================================
                 FLUXO DE CAIXA
                 Agora é uma opção normal do menu
                 ================================================= -->

            <a class="@Item(On("Financeiro", "FluxoCaixa"))"
               asp-controller="Financeiro"
               asp-action="FluxoCaixa">

                <i class="bi bi-bar-chart-line"></i>

                <span>Fluxo de Caixa</span>

            </a>


            <!-- Estoque -->
            <a class="@Item(On("Produto"))"
               asp-controller="Produto"
               asp-action="Index">

                <i class="bi bi-box-seam"></i>

                <span>Estoque</span>

            </a>

            <!-- =================================================
                 CADASTROS
                 ================================================= -->

              <a class="@Item(On("Cadastro"))"
               asp-controller="Cadastro"
               asp-action="Index">

                <i class="bi bi-box-seam"></i>

                <span>Cadastros</span>

            </a>



            <!-- Configurações -->
            <a class="@Item(false)"
               href="#">

                <i class="bi bi-gear"></i>

                <span>Configurações</span>

            </a>

        </nav>


        <!-- =====================================================
             RODAPÉ DO MENU
             ===================================================== -->

        <div class="sidebar-footer">

            <div>
                Usuário:
                <strong>Admin</strong>
            </div>

            <div>
                Empresa: Its Food Brasil
            </div>


            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                <button type="submit"
                        class="btn-sair">

                    <i class="bi bi-box-arrow-right"></i>

                    Sair

                </button>

            </form>

        </div>

    </aside>


    <!-- =====================================================
         ÁREA PRINCIPAL
         ===================================================== -->

    <div class="main">

        <header class="topbar">

            <h1>
                @ViewData["Title"]
            </h1>

        </header>


        <main class="content">

            @RenderBody()

        </main>

    </div>

</div>

</body>

</html>