@using System.Linq

@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool On(string c, string? a = null) =>
        ctrl == c && (a == null || act == a);

    bool Grupo(params string[] cs) =>
        cs.Contains(ctrl);

    string Item(bool ativo) =>
        ativo ? "nav-item active" : "nav-item";

    string Sub(bool ativo) =>
        ativo ? "sub-item active" : "sub-item";

    string Group(bool aberto) =>
        aberto ? "nav-group open" : "nav-group";
}
@if (TempData["Sucesso"] is string sucesso)
{
    <div style="background:#e3f4e6; color:#1e7a34; padding:10px 14px; border-radius:8px; margin-bottom:16px;">
        @sucesso
    </div>
}
@if (TempData["Erro"] is string erroGeral && ViewContext.RouteData.Values["controller"]?.ToString() != "Cadastro")
{
    <div style="background:#fde6e6; color:#b3261e; padding:10px 14px; border-radius:8px; margin-bottom:16px;">
        @erroGeral
    </div>
}
<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Its Food Brasil</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>
<body>

<div class="app">

    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <aside class="sidebar">

        <!-- Logo / Empresa -->
        <div class="brand">

            <div class="brand-logo">
                <img src="~/Assets/logo-itsfoodmedium.png"/>
            </div>

            <small>
                Distribuição de Embutidos
            </small>

        </div>


        <!-- =================================================
             MENU
             ================================================= -->

        <nav class="nav">

            <!-- Dashboard -->
            <a class="@Item(On("Home"))"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-house-door"></i>

                <span>Dashboard</span>

            </a>


            <!-- Caixa / PDV -->
            <a class="@Item(On("Venda", "Create"))"
               asp-controller="Venda"
               asp-action="Create">

                <i class="bi bi-cash-stack"></i>

                <span>Caixa / PDV</span>

            </a>


            <!-- Vendas -->
            <a class="@Item(On("Venda") && act != "Create")"
               asp-controller="Venda"
               asp-action="Index">

                <i class="bi bi-receipt"></i>

                <span>Vendas</span>

            </a>


            <!-- Fluxo de caixa -->
                 

            <a class="@Item(On("Financeiro", "FluxoCaixa"))"
               asp-controller="Financeiro"
               asp-action="FluxoCaixa">

                <i class="bi bi-bar-chart-line"></i>

                <span>Fluxo de Caixa</span>

            </a>


            <!-- Estoque -->
            <a class="@Item(On("Produto"))"
               asp-controller="Produto"
               asp-action="Index">

                <i class="bi bi-box-seam"></i>

                <span>Estoque</span>

            </a>

            <!-- Cadastros -->

              <a class="@Item(On("Cadastro"))"
               asp-controller="Cadastro"
               asp-action="Index">

                <i class="bi bi-person"></i>   

                <span>Cadastros</span>

            </a>

        </nav>


        <!-- =====================================================
             RODAPÉ DO MENU
             ===================================================== -->

        <div class="sidebar-footer">

            <div>
                Usuário:
                <strong>@(User.Identity?.Name ?? "-")</strong>
            </div>

            <div>
                Empresa: Its Food Brasil
            </div>


            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                <button type="submit"
                        class="btn-sair">

                    <i class="bi bi-box-arrow-right"></i>

                    Sair

                </button>

            </form>

        </div>

    </aside>


    <!-- =====================================================
         ÁREA PRINCIPAL
         ===================================================== -->

    <div class="main">

        <header class="topbar">

            <h1>
                @ViewData["Title"]
            </h1>

        </header>


        <main class="content">

            @RenderBody()

        </main>

    </div>

</div>

</body>

</html>